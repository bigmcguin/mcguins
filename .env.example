# Database (Neon recommended).
# DATABASE_URL is the pooled connection used by the running app.
# DIRECT_URL is the non-pooled connection used by Prisma migrations.
# Get both from the Neon dashboard (the pooled host has "-pooler" in it).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Search (Meilisearch)
MEILISEARCH_HOST="https://your-instance.meilisearch.io"
MEILISEARCH_MASTER_KEY=""
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=""

# Maps (Mapbox)
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Email
RESEND_API_KEY=""
ENQUIRY_INBOX="enquiries@example.com.au"

# Images
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Observability
NEXT_PUBLIC_POSTHOG_KEY=""
SENTRY_DSN=""

# Site
NEXT_PUBLIC_SITE_URL="https://example.com.au"
